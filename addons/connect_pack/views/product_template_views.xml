<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_paper" model="ir.ui.view">
        <field name="name">product.template.form.connect.pack.paper</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="group_general" position="after">
                <group name="cp_paper" string="بيانات الورق">
                    <field name="cp_family_id"/>
                    <field name="cp_main_id" readonly="1"/>
                    <field name="cp_sub_id" readonly="1"/>
                    <field name="cp_mill_id" readonly="1"/>
                    <field name="cp_grade_id" readonly="1"/>
                    <field name="cp_grammage"/>
                    <field name="cp_width"/>
                    <field name="cp_code" readonly="1"/>
                </group>
            </group>
        </field>
    </record>

    <record id="view_product_template_list_paper" model="ir.ui.view">
        <field name="name">product.template.list.connect.pack.paper</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="cp_code" optional="show" string="كود الصنف"/>
                <field name="cp_family_id" optional="hide"/>
                <field name="cp_grammage" optional="hide"/>
                <field name="cp_width" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_search_paper" model="ir.ui.view">
        <field name="name">product.template.search.connect.pack.paper</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="cp_family_id"/>
                <field name="cp_main_id"/>
                <field name="cp_sub_id"/>
                <field name="cp_mill_id"/>
            </field>
        </field>
    </record>

</odoo>
