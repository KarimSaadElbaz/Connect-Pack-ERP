<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_lot_form_paper" model="ir.ui.view">
        <field name="name">stock.lot.form.connect.pack.paper</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="cp_roll_weight"/>
            </field>
        </field>
    </record>

    <record id="view_stock_lot_list_paper" model="ir.ui.view">
        <field name="name">stock.lot.list.connect.pack.paper</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="cp_roll_weight" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
